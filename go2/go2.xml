<mujoco model="unitree_go2_simplified">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" iterations="50"/>

  <default>
    <joint damping="0.8" armature="0.02" frictionloss="0.02"/>
    <geom condim="4" friction="0.9 0.1 0.01" density="850" rgba="0.18 0.20 0.22 1"/>
    <position kp="55" kv="4" ctrllimited="true" forcelimited="true" ctrlrange="-3 3" forcerange="-35 35"/>
    <default class="hip">
      <joint type="hinge" axis="1 0 0" range="-0.8 0.8"/>
    </default>
    <default class="thigh">
      <joint type="hinge" axis="0 1 0" range="-1.6 1.6"/>
    </default>
    <default class="calf">
      <joint type="hinge" axis="0 1 0" range="-2.7 -0.25"/>
    </default>
    <default class="foot">
      <geom type="sphere" size="0.028" density="500" rgba="0.06 0.07 0.08 1"/>
    </default>
  </default>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba haze="0.12 0.18 0.22 1"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.16 0.19 0.20" rgb2="0.10 0.12 0.13" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="shell" rgba="0.78 0.82 0.84 1"/>
    <material name="joint" rgba="0.08 0.10 0.11 1"/>
    <material name="accent" rgba="0.95 0.45 0.08 1"/>
  </asset>

  <worldbody>
    <light pos="0 -2 3" dir="0 0.5 -1" directional="true"/>
    <geom name="ground" type="plane" size="5 5 0.05" density="0" material="floor"/>

    <body name="base" pos="0 0 0.43">
      <freejoint/>
      <geom name="trunk" type="box" size="0.29 0.105 0.065" material="shell"/>
      <geom name="front_panel" type="box" pos="0.295 0 0.005" size="0.018 0.085 0.045" material="accent"/>
      <site name="imu" size="0.01" rgba="0 1 0 1"/>

      <body name="FL_hip" pos="0.22 0.105 0">
        <joint name="FL_hip_joint" class="hip"/>
        <geom type="capsule" fromto="0 0 0 0 0.055 0" size="0.045" material="joint"/>
        <body name="FL_thigh" pos="0 0.055 0">
          <joint name="FL_thigh_joint" class="thigh"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.035" material="shell"/>
          <body name="FL_calf" pos="0 0 -0.205">
            <joint name="FL_calf_joint" class="calf"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.027" material="joint"/>
            <geom name="FL_foot" class="foot" pos="0 0 -0.215"/>
          </body>
        </body>
      </body>

      <body name="FR_hip" pos="0.22 -0.105 0">
        <joint name="FR_hip_joint" class="hip"/>
        <geom type="capsule" fromto="0 0 0 0 -0.055 0" size="0.045" material="joint"/>
        <body name="FR_thigh" pos="0 -0.055 0">
          <joint name="FR_thigh_joint" class="thigh"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.035" material="shell"/>
          <body name="FR_calf" pos="0 0 -0.205">
            <joint name="FR_calf_joint" class="calf"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.027" material="joint"/>
            <geom name="FR_foot" class="foot" pos="0 0 -0.215"/>
          </body>
        </body>
      </body>

      <body name="RL_hip" pos="-0.22 0.105 0">
        <joint name="RL_hip_joint" class="hip"/>
        <geom type="capsule" fromto="0 0 0 0 0.055 0" size="0.045" material="joint"/>
        <body name="RL_thigh" pos="0 0.055 0">
          <joint name="RL_thigh_joint" class="thigh"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.035" material="shell"/>
          <body name="RL_calf" pos="0 0 -0.205">
            <joint name="RL_calf_joint" class="calf"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.027" material="joint"/>
            <geom name="RL_foot" class="foot" pos="0 0 -0.215"/>
          </body>
        </body>
      </body>

      <body name="RR_hip" pos="-0.22 -0.105 0">
        <joint name="RR_hip_joint" class="hip"/>
        <geom type="capsule" fromto="0 0 0 0 -0.055 0" size="0.045" material="joint"/>
        <body name="RR_thigh" pos="0 -0.055 0">
          <joint name="RR_thigh_joint" class="thigh"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.035" material="shell"/>
          <body name="RR_calf" pos="0 0 -0.205">
            <joint name="RR_calf_joint" class="calf"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.205" size="0.027" material="joint"/>
            <geom name="RR_foot" class="foot" pos="0 0 -0.215"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="FL_hip" joint="FL_hip_joint"/><position name="FL_thigh" joint="FL_thigh_joint"/><position name="FL_calf" joint="FL_calf_joint"/>
    <position name="FR_hip" joint="FR_hip_joint"/><position name="FR_thigh" joint="FR_thigh_joint"/><position name="FR_calf" joint="FR_calf_joint"/>
    <position name="RL_hip" joint="RL_hip_joint"/><position name="RL_thigh" joint="RL_thigh_joint"/><position name="RL_calf" joint="RL_calf_joint"/>
    <position name="RR_hip" joint="RR_hip_joint"/><position name="RR_thigh" joint="RR_thigh_joint"/><position name="RR_calf" joint="RR_calf_joint"/>
  </actuator>

  <keyframe>
    <key name="stand" qpos="0 0 0.43 1 0 0 0 0.10 0.72 -1.42 -0.10 0.72 -1.42 0.10 0.72 -1.42 -0.10 0.72 -1.42" ctrl="0.10 0.72 -1.42 -0.10 0.72 -1.42 0.10 0.72 -1.42 -0.10 0.72 -1.42"/>
  </keyframe>
</mujoco>
