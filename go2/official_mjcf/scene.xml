    <geom pos="3 0 0.02" type="box"  size="0.24 2 0.6" quat="1.0 0 0 0" material="stairs"/>
    <geom pos="3.2 0 0.02" type="box"  size="0.25 2 0.75" quat="1.0 0 0 0" material="stairs"/>
    <geom pos="3.4 0 0.02" type="box"  size="0.26 2 0.9" quat="1.0 0 0 0" material="stairs"/>
  </worldbody>
</mujoco>
