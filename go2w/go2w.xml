  <keyframe>
    <key name="drive" qpos="0 0 0.40 1 0 0 0 0.08 0.58 -1.12 0 -0.08 0.58 -1.12 0 0.08 0.58 -1.12 0 -0.08 0.58 -1.12 0" ctrl="0.08 0.58 -1.12 -0.08 0.58 -1.12 0.08 0.58 -1.12 -0.08 0.58 -1.12 0 0 0 0"/>
